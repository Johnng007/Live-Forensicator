{
  "title": "Suspicious Windows Service Tampering",
  "rule_id": "ce72ef99-22f1-43d4-8695-419dcb5d9330",
  "description": "Detects the usage of binaries such as 'net', 'sc' or 'powershell' in order to stop, pause, disable or delete critical or important Windows services such as AV, Backup, etc. As seen being used in some ransomware scripts\n",
  "level": "high",
  "status": "test",
  "tags": [
    "attack.impact",
    "attack.defense-impairment",
    "attack.t1489",
    "attack.t1685"
  ],
  "category": "process_creation",
  "rule_file": "rules/windows/process_creation/proc_creation_win_susp_service_tamper.yml",
  "sources": [
    "sysmon_process_creation"
  ],
  "items": {
    "selection_tools_img": {
      "type": "any",
      "children": [
        {
          "type": "all",
          "children": [
            {
              "type": "field",
              "field": "OriginalFileName",
              "operator": "exact",
              "values": [
                "net.exe",
                "net1.exe",
                "PowerShell_ISE.EXE",
                "PowerShell.EXE",
                "psservice.exe",
                "pwsh.dll",
                "sc.exe",
                "wmic.exe"
              ],
              "match": "any",
              "windash": false,
              "ignore_case": true
            }
          ]
        },
        {
          "type": "all",
          "children": [
            {
              "type": "field",
              "field": "Image",
              "operator": "endswith",
              "values": [
                "\\net.exe",
                "\\net1.exe",
                "\\PowerShell_ISE.EXE",
                "\\powershell.exe",
                "\\PsService.exe",
                "\\PsService64.exe",
                "\\pwsh.exe",
                "\\sc.exe",
                "\\wmic.exe"
              ],
              "match": "any",
              "windash": false,
              "ignore_case": true
            }
          ]
        }
      ]
    },
    "selection_tools_cli": {
      "type": "any",
      "children": [
        {
          "type": "all",
          "children": [
            {
              "type": "field",
              "field": "CommandLine",
              "operator": "contains",
              "values": [
                " delete ",
                ".delete()",
                " pause ",
                " stop ",
                "Stop-Service ",
                "Remove-Service "
              ],
              "match": "any",
              "windash": false,
              "ignore_case": true
            }
          ]
        },
        {
          "type": "all",
          "children": [
            {
              "type": "field",
              "field": "CommandLine",
              "operator": "contains",
              "values": [
                "config",
                "start=disabled"
              ],
              "match": "all",
              "windash": false,
              "ignore_case": true
            }
          ]
        }
      ]
    },
